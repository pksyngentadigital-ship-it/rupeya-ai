# Rupeya.ai scrapers — environment variables
# Copy this file to ".env" in the same folder and fill in real values.
# .env is git-ignored and never gets pushed.

# --- Supabase (same project as the Next.js app) ---
# These come from your Supabase project Settings → API page.
SUPABASE_URL=https://geyhpmvuoslyeuhhezpv.supabase.co

# IMPORTANT: this is the SECRET / service-role key (sb_secret_...).
# It bypasses Row-Level Security so the scraper can write data.
# Never paste this anywhere public. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (for B3a fundamentals PDF extraction) ---
# Used by the fundamentals scraper to parse PSX filing PDFs into
# structured JSON. Same key as the app's .env.local — safe to reuse,
# but you can also generate a scraper-scoped key in the Anthropic
# console (https://console.anthropic.com → API keys) if you want to
# track scraper spend separately.
ANTHROPIC_API_KEY=

# --- Behavior knobs (optional) ---
# Seconds between PSX requests (1 = 1 req/sec, polite default)
SCRAPE_DELAY_SECONDS=1

# Limit number of tickers per run (useful for local smoke tests)
# Set to 0 (default) to scrape the entire covered universe.
SCRAPE_LIMIT=0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
